# Copy to .env for local use. Production values must come from a secret
# manager or CI/CD secret store; never commit the resulting .env file.
COMPOSE_PROJECT_NAME=folhea-local
AO_SESSION_ID=manual
PUBLIC_DOMAIN=localhost
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTP_PORT=9080
HTTPS_PORT=9443
# Listener for scripts/dev-backend.sh; independent of the public edge port.
DEV_HTTP_PORT=8080

DB_NAME=folhea
DB_USERNAME=folhea
DB_PASSWORD=replace-with-a-long-random-database-secret
# For `./mvnw quarkus:dev` on the host, Compose Postgres is published on 5433
# via docker-compose.override.yml (see docker-compose.override.example.yml).
# localhost:5432 is often the system PostgreSQL, not Folhea.
# The same override publishes Keycloak on 127.0.0.1:8180 for quarkus:dev +
# ng serve (without Caddy). %dev OIDC URLs are http://localhost:8180, not the
# Caddy values below.
DB_JDBC_URL=jdbc:postgresql://localhost:5433/folhea

# Must match the Caddy address on the internal edge network.
EDGE_SUBNET=172.31.44.0/24
CADDY_IPV4=172.31.44.2
BACKEND_IPV4=172.31.44.3
TRUSTED_PROXIES=172.31.44.2
# Unique edge-only alias: backend also joins the private network.
# The BFF trusts only Caddy's edge IP, so do not use the ambiguous backend alias.
API_UPSTREAM=http://backend-edge:8080

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret

KEYCLOAK_ADMIN_BASE_URL=http://localhost:8180
KEYCLOAK_ADMIN_REALM=folhea
KEYCLOAK_ADMIN_CLIENT_ID=folhea-registration
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-long-random-registration-secret

OIDC_TOKEN_STATE_SECRET=replace-with-at-least-32-random-characters
# Keep the OIDC post-logout state cookie until the callback validates it.
# Session cookies are expired explicitly; clearing all cookies early breaks state.
OIDC_LOGOUT_CLEAR_SITE_DATA=cache,storage
OIDC_CLIENT_ID=folhea-api
# Confidential BFF client secret rendered into the Keycloak realm import.
OIDC_CLIENT_SECRET=replace-with-a-long-random-oidc-client-secret
# Public issuer and browser endpoints. Back-channel calls use the internal
# OIDC_AUTH_SERVER_URL supplied by Compose and never expose keycloak:8080.
OIDC_PUBLIC_ORIGIN=https://localhost:9443
OIDC_PUBLIC_ISSUER=https://localhost:9443/realms/folhea
OIDC_PUBLIC_AUTHORIZATION_URL=https://localhost:9443/realms/folhea/protocol/openid-connect/auth
OIDC_PUBLIC_LOGOUT_URL=https://localhost:9443/realms/folhea/protocol/openid-connect/logout
CORS_ENABLED=false
# The public browser origin used by the BFF. Set both to the production HTTPS
# origin when deploying outside this local Compose stack.
SECURITY_CANONICAL_ORIGIN=https://localhost:9443
SECURITY_ALLOWED_ORIGINS=https://localhost:9443
REDIS_PASSWORD=replace-with-a-long-random-redis-secret
JSON_LOGGING=true
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Optional providers: set only when the corresponding external service exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Optional remote backup configuration; credentials come from the local AWS profile.
BACKUP_EXTERNAL_DESTINATION=
BACKUP_RETENTION_DAYS=7
AWS_ENDPOINT_URL=
