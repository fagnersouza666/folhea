# Copy to .env for local use. Production values must come from a secret
# manager or CI/CD secret store; never commit the resulting .env file.
PUBLIC_DOMAIN=localhost
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

DB_NAME=folhea
DB_USERNAME=folhea
DB_PASSWORD=replace-with-a-long-random-database-secret

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret

OIDC_CLIENT_ID=folhea-api
# Leave empty for the imported PKCE public client, or inject a confidential
# client secret when the BFF configuration is changed to use one.
OIDC_CLIENT_SECRET=
OIDC_TOKEN_ISSUER=http://keycloak:8080/realms/folhea
CORS_ENABLED=false
# The public browser origin used by the BFF. Set both to the production HTTPS
# origin when deploying outside this local Compose stack.
SECURITY_CANONICAL_ORIGIN=https://localhost:8443
SECURITY_ALLOWED_ORIGINS=https://localhost:8443
JSON_LOGGING=true
METRICS_ENABLED=false
