{
  "name": "folhea-frontend",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:ssg": "ng build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" \"playwright*.config.ts\"",
    "e2e:critical": "playwright test --config=playwright.config.ts",
    "e2e:integrated": "playwright test --config=playwright.integrated.config.ts",
    "validate:ssg": "node scripts/validate-ssg.mjs"
  },
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/service-worker": "22.2.2",
    "@angular/ssr": "22.2.2",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "1.64.0",
    "@vitest/coverage-v8": "5.0.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@angular/build": "22.2.2"
  },
  "type": "module"
}
