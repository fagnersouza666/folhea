{
  "name": "folhea-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:ssg": "ng build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "e2e:critical": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/service-worker": "22.1.5",
    "@angular/ssr": "22.1.5",
    "express": "^5.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
