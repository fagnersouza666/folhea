{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/*.css", "/*.js", "/*.woff2"]
      }
    },
    {
      "name": "public",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**", "/*.svg", "/*.png"] }
    }
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": ["/api/v1/**"],
      "cacheConfig": { "maxSize": 50, "maxAge": "1h", "strategy": "freshness", "timeout": "5s" }
    }
  ]
}
